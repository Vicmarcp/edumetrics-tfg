rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Usuarios (profesores)
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Alumnos
    match /students/{studentId} {
      allow read: if request.auth != null
                  && resource.data.schoolId is string;
      allow create: if request.auth != null
                    && request.resource.data.schoolId is string
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 50;
      allow update: if request.auth != null
                    && resource.data.schoolId is string;
      allow delete: if request.auth != null
                    && resource.data.schoolId is string;
    }

    // Resultados de actividades (inmutables)
    match /results/{resultId} {
      allow read: if request.auth != null
                  && resource.data.schoolId is string;
      allow create: if request.auth != null
                    && request.resource.data.schoolId is string
                    && request.resource.data.studentId is string
                    && request.resource.data.activityType is string;
      allow update: if false;
      allow delete: if request.auth != null
                    && resource.data.schoolId is string;
    }

    // Logs de auditoría (solo escritura)
    match /audit_logs/{logId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
  }
}
